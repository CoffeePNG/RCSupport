DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set BOTH to enable semantic routing: tickets -> Public, archive -> Staff.
# Leave BOTH unset to preserve legacy routing during an upgrade.
PUBLIC_GUILD_ID=
STAFF_GUILD_ID=
# Optional additional/legacy deployment targets; retain old targets during migration
# so command registration removes commands that no longer belong there.
DISCORD_GUILD_IDS=
# Legacy only (ignored when STAFF_GUILD_ID is set): /archive guilds.
# Defaults to 903819888903200798.
ARCHIVE_GUILD_IDS=
# Set to false to stop the bot registering slash commands on boot
DEPLOY_COMMANDS_ON_START=
DATABASE_PATH=data/rcbot.sqlite

# RCSupportBridge Forum integration (use a reachable HTTPS address, not 127.0.0.1 across containers)
RCSUPPORT_API_BASE_URL=https://127.0.0.1:28120
RCSUPPORT_API_TOKEN=
RCSUPPORT_API_CA_CERT_PATH=
RCSUPPORT_POLL_INTERVAL_MS=20000
RCSUPPORT_ALERT_MODE_CACHE_MS=60000
# Optional fallback; /bugreport setup saves the Forum in SQLite and overrides this.
RCSUPPORT_FORUM_CHANNEL_ID=

# Optional persistent staff permission/role mapping file; see docs/STAFF_MANAGEMENT.md
STAFF_CONFIG_PATH=
